--- 25. vw_agenda_medica
CREATE VIEW vw_agenda_medica AS
SELECT 
    m.nome_medico, 
    e.nome_especialidade, 
    p.nome_paciente, 
    c.data, 
    c.horario, 
    c.status
FROM CONSULTA c
JOIN MEDICO m ON c.id_medico = m.id_medico
JOIN ESPECIALIDADE e ON c.id_especialidade = e.id_especialidade
JOIN PACIENTE p ON c.id_paciente = p.id_paciente
WHERE c.status IN ('agendada', 'realizada');

--- 26. vw_historico_paciente
CREATE VIEW vw_historico_paciente AS
SELECT 
    p.nome_paciente, 
    c.data, 
    c.diagnostico,
    pr.medicamento, 
    pr.dosagem
FROM PACIENTE p
JOIN CONSULTA c ON p.id_paciente = c.id_paciente
LEFT JOIN PRESCRICAO pr ON c.id_consulta = pr.id_consulta
WHERE c.status = 'realizada';

