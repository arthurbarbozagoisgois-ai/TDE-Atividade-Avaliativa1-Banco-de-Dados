-- 13. Pacientes cadastrados após uma data, ordenados
SELECT nome, cpf, email, data_cadastro 
FROM Paciente 
WHERE data_cadastro > '2023-01-01' 
ORDER BY nome ASC;

-- 14. Médicos e especialidades (incluindo sem especialidade)
SELECT m.nome AS medico, e.nome AS especialidade
FROM Medico m
LEFT JOIN Medico_Especialidade me ON m.id_medico = me.id_medico
LEFT JOIN Especialidade e ON me.id_especialidade = e.id_especialidade;

-- 15. Quantidade de consultas e valor médio por médico
SELECT m.nome, COUNT(c.id_consulta) AS qtd_consultas, AVG(c.valor) AS valor_medio
FROM Medico m
JOIN Consulta c ON m.id_medico = c.id_medico
WHERE c.status = 'realizada'
GROUP BY m.nome;

-- 16. Médicos com mais de 3 consultas
SELECT m.nome, COUNT(c.id_consulta) AS qtd_consultas
FROM Medico m
JOIN Consulta c ON m.id_medico = c.id_medico
GROUP BY m.nome
HAVING COUNT(c.id_consulta) > 3;

-- 17. Consultas agendadas nos próximos 7 dias
SELECT p.nome AS paciente, m.nome AS medico, c.data, c.horario
FROM Consulta c
INNER JOIN Paciente p ON c.id_paciente = p.id_paciente
INNER JOIN Medico m ON c.id_medico = m.id_medico
WHERE c.status = 'agendada' 
  AND c.data BETWEEN CURRENT_DATE AND CURRENT_DATE + INTERVAL '7 days';

-- 18. Pacientes e data da última consulta (mesmo sem consulta)
SELECT p.nome, MAX(c.data) AS ultima_consulta
FROM Paciente p
LEFT JOIN Consulta c ON p.id_paciente = c.id_paciente
GROUP BY p.nome;

-- 19. Total faturado por especialidade nas consultas realizadas
SELECT e.nome AS especialidade, SUM(c.valor) AS total_faturado
FROM Especialidade e
JOIN Consulta c ON e.id_especialidade = c.id_especialidade
WHERE c.status = 'realizada'
GROUP BY e.nome;

-- 20. Top 3 médicos com maior quantidade de consultas
SELECT m.nome, COUNT(c.id_consulta) AS total_consultas
FROM Medico m
JOIN Consulta c ON m.id_medico = c.id_medico
WHERE c.status = 'realizada'
GROUP BY m.nome
ORDER BY total_consultas DESC
LIMIT 3;

-- 21. Faturamento mensal em consultas realizadas
SELECT EXTRACT(MONTH FROM data) AS mes, EXTRACT(YEAR FROM data) AS ano, SUM(valor) AS faturamento
FROM Consulta
WHERE status = 'realizada'
GROUP BY EXTRACT(MONTH FROM data), EXTRACT(YEAR FROM data)
ORDER BY ano, mes;
